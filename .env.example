EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=test_your_test_store_key
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_your_public_sdk_key
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_your_public_sdk_key
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID="com.smlztrk.seelogd Pro"

# ── Ölçüm (Faz 1) ────────────────────────────────────────────────────────────
# Sentry DSN — sentry.io'da proje açtıktan sonra Settings → Client Keys (DSN).
# BOŞ BIRAKILABİLİR: DSN yoksa hata raporlama sessizce kapalı kalır, uygulama
# normal çalışır (services/crashReporting.js).
EXPO_PUBLIC_SENTRY_DSN=

# Geliştirmede de Sentry'ye gerçekten gönder (varsayılan: gönderme).
# EXPO_PUBLIC_SENTRY_DEV=1

# Sentry auth token — SADECE BUILD ZAMANI, uygulamaya gömülmez (EXPO_PUBLIC_ yok!).
# Release build'de sentry.gradle kaynak haritalarını bununla yükler; yoksa
# ":app:createBundleReleaseJsAndAssets_SentryUpload" görevi build'i düşürür.
# sentry.io → Settings → Auth Tokens (scope: project:releases, org:read).
# EAS bulut build'i .env dosyalarını YÜKLEMEZ; sunucuya secret olarak eklenmeli:
#   eas env:create --name SENTRY_AUTH_TOKEN --value <token> --visibility secret \
#     --environment production --environment preview
# Yükleme yapılmasın isteniyorsa: SENTRY_DISABLE_AUTO_UPLOAD=true
SENTRY_AUTH_TOKEN=

# Geliştirmede Analytics olaylarını gerçekten Firebase'e gönder. Varsayılan
# olarak yalnız konsola yazılır — üretim panosu test verisiyle kirlenmesin
# (services/analytics.js).
# EXPO_PUBLIC_ANALYTICS_DEV=1
