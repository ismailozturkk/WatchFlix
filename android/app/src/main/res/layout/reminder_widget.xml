<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/reminder_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/reminder_widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/reminder_widget_logo_badge"
            android:gravity="center"
            android:text="W"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/reminder_widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/reminder_widget_preview_title"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/reminder_widget_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/reminder_widget_count_badge"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="@string/reminder_widget_preview_count"
            android:textColor="#C9C7FF"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="7dp"
        android:layout_marginBottom="5dp"
        android:background="#1FFFFFFF" />

    <TextView
        android:id="@+id/reminder_widget_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/reminder_widget_empty"
        android:textColor="#94A0B8"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/reminder_widget_row_1"
        style="@style/ReminderWidgetRow"
        android:visibility="gone">

        <TextView
            android:id="@+id/reminder_widget_badge_1"
            style="@style/ReminderWidgetTypeBadge" />

        <LinearLayout style="@style/ReminderWidgetTextColumn">
            <TextView
                android:id="@+id/reminder_widget_name_1"
                style="@style/ReminderWidgetTitle" />
            <TextView
                android:id="@+id/reminder_widget_meta_1"
                style="@style/ReminderWidgetMeta" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/reminder_widget_row_2"
        style="@style/ReminderWidgetRow"
        android:visibility="gone">

        <TextView
            android:id="@+id/reminder_widget_badge_2"
            style="@style/ReminderWidgetTypeBadge" />

        <LinearLayout style="@style/ReminderWidgetTextColumn">
            <TextView
                android:id="@+id/reminder_widget_name_2"
                style="@style/ReminderWidgetTitle" />
            <TextView
                android:id="@+id/reminder_widget_meta_2"
                style="@style/ReminderWidgetMeta" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/reminder_widget_row_3"
        style="@style/ReminderWidgetRow"
        android:visibility="gone">

        <TextView
            android:id="@+id/reminder_widget_badge_3"
            style="@style/ReminderWidgetTypeBadge" />

        <LinearLayout style="@style/ReminderWidgetTextColumn">
            <TextView
                android:id="@+id/reminder_widget_name_3"
                style="@style/ReminderWidgetTitle" />
            <TextView
                android:id="@+id/reminder_widget_meta_3"
                style="@style/ReminderWidgetMeta" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/reminder_widget_row_4"
        style="@style/ReminderWidgetRow"
        android:visibility="gone">

        <TextView
            android:id="@+id/reminder_widget_badge_4"
            style="@style/ReminderWidgetTypeBadge" />

        <LinearLayout style="@style/ReminderWidgetTextColumn">
            <TextView
                android:id="@+id/reminder_widget_name_4"
                style="@style/ReminderWidgetTitle" />
            <TextView
                android:id="@+id/reminder_widget_meta_4"
                style="@style/ReminderWidgetMeta" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/reminder_widget_more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="@string/reminder_widget_more"
        android:textColor="#C9C7FF"
        android:textSize="10sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
