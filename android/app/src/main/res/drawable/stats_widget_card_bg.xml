<?xml version="1.0" encoding="utf-8"?>
<!-- Dış kart — profildeki `watchStats` (theme.border + accent gradyan katmanı)
     karşılığı. RemoteViews'te ayrı gradyan View'i yerine tek shape kullanılır. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
  <gradient android:angle="315" android:startColor="#2E6C63FF" android:endColor="#141726" />
  <corners android:radius="18dp" />
  <stroke android:width="1dp" android:color="#1FFFFFFF" />
</shape>
