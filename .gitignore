# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
android/
ios/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
credentials.json

# Keep the renamed Android application package sources visible to Git.
!android/
android/*
!android/app/
android/app/*
!android/app/src/
android/app/src/*
!android/app/src/main/
android/app/src/main/*
!android/app/src/main/java/
android/app/src/main/java/*
!android/app/src/main/java/com/
android/app/src/main/java/com/*
!android/app/src/main/java/com/smlztrk/
android/app/src/main/java/com/smlztrk/*
!android/app/src/main/java/com/smlztrk/seelogd/
android/app/src/main/java/com/smlztrk/seelogd/*
!android/app/src/main/java/com/smlztrk/seelogd/MainActivity.kt
!android/app/src/main/java/com/smlztrk/seelogd/MainApplication.kt
# Widget kaynak sınıflarının TAMAMI izlenir. Önceden dosya-dosya beyaz liste
# vardı ve sonradan eklenen her sınıf sessizce commit dışı kalıyordu
# (ReminderWidgetRemoteViewsService.kt bu yüzden hiç izlenmemişti — widget
# temiz bir klonda derlenmezdi).
!android/app/src/main/java/com/smlztrk/seelogd/widget/

# Widget res kaynakları (layout / drawable / xml). Aynı tuzak burada da vardı:
# android/app/src/main/* kuralı res'i komple eliyor, bu yüzden yeni layout ve
# drawable'lar eklenince görünmüyordu. "*widget*" kalıbıyla yalnız widget
# kaynakları izlenir; Expo'nun ürettiği diğer res dosyaları yok sayılmaya devam.
!android/app/src/main/res/
android/app/src/main/res/*
!android/app/src/main/res/layout/
android/app/src/main/res/layout/*
!android/app/src/main/res/layout/*widget*.xml
!android/app/src/main/res/drawable/
android/app/src/main/res/drawable/*
!android/app/src/main/res/drawable/*widget*.xml
!android/app/src/main/res/xml/
android/app/src/main/res/xml/*
!android/app/src/main/res/xml/*widget*.xml

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo
.env

# debug/build artifacts
crash.txt
.expo-check-export/

# Claude Code worktree'leri (~50 MB). .claude/launch.json ve settings.local.json
# bilerek izleniyor, yalnız worktrees haric tutuluyor.
.claude/worktrees/

# FCM / service account (gizli — asla commit etme)
*-firebase-adminsdk-*.json

# Firebase hosting deploy onbellegi
.firebase/

# Windows'ta "> nul" ile bastirilan cikti, bash altinda gercek bir DOSYA olur
# (null aygiti degil). Arada bir kokte 20-30 KB'lik cop dosya birakiyor.
nul

# Rebrand oncesi ikon yedekleri — yerelde kalsin, 4,5 MB olu varlik olarak
# gecmise girmesin. Gerceklestirilen ikonlar assets/ kokunde.
assets/oldicon/
assets/oldicon1/

.env.local
