<?xml version="1.0" encoding="utf-8"?>
<!-- 3 sütunlu poster ızgarası anlamlı görünsün diye minWidth 4 hücre;
     minResizeHeight tek poster sırası + seçici şeridi kadar. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/lists_widget_description"
    android:initialLayout="@layout/lists_widget"
    android:minWidth="250dp"
    android:minHeight="180dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="140dp"
    android:previewImage="@drawable/lists_widget_preview"
    android:previewLayout="@layout/lists_widget_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
