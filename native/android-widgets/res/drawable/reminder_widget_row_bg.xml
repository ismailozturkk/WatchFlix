<?xml version="1.0" encoding="utf-8"?>
<!-- Runtime'da temanın surfaceAlt rengiyle SRC_IN tint'lenir (bkz.
     WidgetThemeViews.tintBackground) — bu dosyadaki RGB önemsiz, yalnızca
     ALFA korunur. Eskiden #14 (~%8) idi ve koyu zeminlerde satır neredeyse
     görünmüyordu; #3D (~%24) ile kart, widget zemini üzerinde belirgin ama
     ağır olmayan ayrı bir yüzey olarak okunur. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
  <solid android:color="#3DFFFFFF" />
  <corners android:radius="13dp" />
  <stroke android:width="1dp" android:color="#42FFFFFF" />
</shape>
