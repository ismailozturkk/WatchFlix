<?xml version="1.0" encoding="utf-8"?>
<!-- Widget seçici için görsel önizleme (android:previewImage).
     previewLayout API 31+; daha eski launcher'lar bu drawable'ı gösterir.
     Ölçüler 252×190dp'lik nominal bir karta göre: 12dp kenar boşluğu,
     3 sütun × 72dp, 6dp aralık. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Kart zemini -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="#070A14"
                android:startColor="#171331" />
            <corners android:radius="20dp" />
            <stroke
                android:width="1.5dp"
                android:color="#406C63FF" />
        </shape>
    </item>

    <!-- Liste seçici şeridi -->
    <item
        android:height="32dp"
        android:left="12dp"
        android:right="12dp"
        android:top="14dp">
        <shape android:shape="rectangle">
            <solid android:color="#16FFFFFF" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="#14FFFFFF" />
        </shape>
    </item>

    <!-- Seçicideki liste ikonu (favoriler kırmızısı) -->
    <item
        android:width="20dp"
        android:height="20dp"
        android:left="20dp"
        android:top="20dp">
        <shape android:shape="oval">
            <solid android:color="#40F87171" />
        </shape>
    </item>

    <!-- 1. sıra posterler -->
    <item
        android:height="62dp"
        android:left="12dp"
        android:right="168dp"
        android:top="54dp">
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:endColor="#1B1B33" android:startColor="#3A2E6B" />
            <corners android:radius="9dp" />
        </shape>
    </item>
    <item
        android:height="62dp"
        android:left="90dp"
        android:right="90dp"
        android:top="54dp">
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:endColor="#161E2E" android:startColor="#2A3F63" />
            <corners android:radius="9dp" />
        </shape>
    </item>
    <item
        android:height="62dp"
        android:left="168dp"
        android:right="12dp"
        android:top="54dp">
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:endColor="#241626" android:startColor="#5B2E4A" />
            <corners android:radius="9dp" />
        </shape>
    </item>

    <!-- 2. sıra posterler -->
    <item
        android:height="62dp"
        android:left="12dp"
        android:right="168dp"
        android:top="122dp">
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:endColor="#241626" android:startColor="#5B2E4A" />
            <corners android:radius="9dp" />
        </shape>
    </item>
    <item
        android:height="62dp"
        android:left="90dp"
        android:right="90dp"
        android:top="122dp">
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:endColor="#1B1B33" android:startColor="#3A2E6B" />
            <corners android:radius="9dp" />
        </shape>
    </item>
    <item
        android:height="62dp"
        android:left="168dp"
        android:right="12dp"
        android:top="122dp">
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:endColor="#161E2E" android:startColor="#2A3F63" />
            <corners android:radius="9dp" />
        </shape>
    </item>

</layer-list>
