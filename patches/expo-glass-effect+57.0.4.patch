+// Polls the opacity of glass views whose effect is installed. UIKit drops a glass effect
+// that is drawn while (nearly) transparent and does not draw it again by itself
+// (iOS 26.1+, https://developer.apple.com/forums/thread/808410), and an ancestor's opacity
+// change is not observable from here: fade-in entrances, fading modals and hidden tabs
+// left the glass invisible. One shared low-rate timer for all views instead of a display
+// link per view; it stops when no view is tracked.
+@MainActor
+private final class GlassVisibilityMonitor: NSObject {
+  static let shared = GlassVisibilityMonitor()
+
+  private let views = NSHashTable<GlassView>.weakObjects()
+  private var timer: Timer?
+
+  func track(_ view: GlassView) {
+    views.add(view)
+    guard timer == nil else {
+      return
+    }
+    let timer = Timer(timeInterval: 0.12, target: self, selector: #selector(tick), userInfo: nil, repeats: true)
+    timer.tolerance = 0.04
+    RunLoop.main.add(timer, forMode: .common)
+    self.timer = timer
+  }
+
+  func untrack(_ view: GlassView) {
+    views.remove(view)
+    if views.allObjects.isEmpty {
+      stop()
+    }
+  }
+
+  @objc private func tick() {
+    let tracked = views.allObjects
+    if tracked.isEmpty {
+      stop()
+      return
+    }
+    for view in tracked {
+      view.sampleOpacity()
+    }
+  }
+
+  private func stop() {
+    timer?.invalidate()
+    timer = nil
+  }
+}
