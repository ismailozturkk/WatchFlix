rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ────────────────────────────────────────────────────────
    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function onlyUpdating(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }
    function notBlocked(uid) {
      return !exists(/databases/$(database)/documents/Users/$(uid)/blocked/$(request.auth.uid));
    }
    // Sayaç cross-write güvenliği: alan ya hiç değişmemiş ya da tam ±1
    // oynamış olmalı (istemci increment(±1) kullanır). Keyfî değer yazımını
    // (troll'ün friendsCount=9999 yapmasını) engeller. Sayı olmayan değer
    // aritmetik hatası üretir → kural false → yazım reddedilir.
    function counterOk(name) {
      return request.resource.data.get(name, 0) is int
          && (request.resource.data.get(name, 0) - resource.data.get(name, 0)) <= 1
          && (request.resource.data.get(name, 0) - resource.data.get(name, 0)) >= -1;
    }
    // 1-1 sohbet üyeliği: chatId "uidKüçük_uidBüyük" biçimindedir (ChatScreen).
    // Eski substring eşleşmesi ('.*uid.*') yerine TAM segment eşleşmesi.
    function isChatMember(chatId) {
      return isSignedIn() && request.auth.uid in chatId.split('_');
    }

    // ─── Landing sitesi: geçici bekleme listesi ─────────────────────────
    match /waitlist/{docId} {
      // E-posta adresi kişisel veridir: koleksiyonu LİSTELEMEK serbest olamaz,
      // yoksa herkes tüm bekleme listesini dökebilir (docId = base64(email) ve
      // 'email' alanı düz metin). Landing yalnızca kendi kaydını tek doküman
      // olarak okur (store.addEmail → getDoc(doc(...,"waitlist", id))), o yüzden
      // get açık, list kapalı.
      allow get: if true;
      allow list: if false;
      allow update, delete: if false;
      allow create: if request.resource.data.keys().hasOnly(['email', 'createdAt', 'source', 'queueNo'])
                    && request.resource.data.email is string
                    && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$')
                    && request.resource.data.email.size() < 200
                    && request.resource.data.source == 'landing'
                    && request.resource.data.queueNo is int;
    }

    match /meta/waitlist {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['count'])
                    && request.resource.data.count is int
                    && request.resource.data.count >= 1;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count'])
                    && request.resource.data.count == resource.data.count + 1;
      allow delete: if false;
    }

    // NOT: /featureRequests kuralı 26 Tem 2026'da kaldırıldı — landing
    // sayfasındaki "sen iste, biz yapalım" bölümü kaldırıldığı için okuyan ya
    // da yazan bir istemci kalmadı. Kural yokken koleksiyon varsayılan olarak
    // kapalıdır; koleksiyondaki ESKİ KAYITLAR silinmez, Firebase Console'dan
    // temizlenmeli.

    // ─── Listeler ───────────────────────────────────────────────────────
    // Gizlilik artık yalnız UI'da değil, KURALDA da uygulanır:
    // Users/{uid}.privacy.lists → 'public' (varsayılan) | 'friends' | 'private'.
    // FriendProfileScreen'deki canViewLists mantığının sunucu karşılığı.
    // Not: kök doküman liste alanlarını da içerdiğinden alan-bazlı (listVisible)
    // ayrım kural düzeyinde yapılamaz; o ayrım UI'da kalır.
    function listsPrivacy(uid) {
      return get(/databases/$(database)/documents/Users/$(uid))
               .data.get('privacy', {}).get('lists', 'public');
    }
    function canReadLists(uid) {
      return isOwner(uid)
          || (isSignedIn()
              && (listsPrivacy(uid) == 'public'
                  || (listsPrivacy(uid) == 'friends'
                      && exists(/databases/$(database)/documents/Users/$(uid)/friends/$(request.auth.uid)))));
    }
    match /Lists/{uid}/{document=**} {
      allow read:  if canReadLists(uid);
      allow write: if isOwner(uid);
    }

    // ─── Ortak Listeler ─────────────────────────────────────────────────
    // SharedLists/{listId}: birden çok kullanıcının paylaştığı özel liste.
    // Yetki modeli (services/sharedListsService.js ile birebir):
    //   • Üyelik: memberIds array'i (kurucu dahil). Okuma yalnız üyelere.
    //   • Kurucu (ownerId) tam yetkili: üye/yetki yönetimi, silme, adlandırma.
    //   • Üye yalnız KENDİNİ çıkarabilir (ayrıl) — başka alan değiştiremez.
    //   • items: canAdd üyesi ekler; ekleyen kendi öğesini, canRemove üyesi
    //     ve kurucu her öğeyi silebilir.
    function sharedList(listId) {
      return get(/databases/$(database)/documents/SharedLists/$(listId)).data;
    }
    match /SharedLists/{listId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.memberIds;

      allow create: if isSignedIn()
                    && request.resource.data.ownerId == request.auth.uid
                    && request.auth.uid in request.resource.data.memberIds;

      allow update: if isSignedIn()
                    && (
                      // Kurucu: her şeyi yönetir; ownerId devredilemez ve
                      // kurucu üyelikten çıkarılamaz.
                      (request.auth.uid == resource.data.ownerId
                       && request.resource.data.ownerId == resource.data.ownerId
                       && request.resource.data.ownerId in request.resource.data.memberIds)
                      ||
                      // Üye: yalnız kendini çıkarır (ayrıl). memberIds eski
                      // kümenin alt kümesi + tam 1 eksik + çıkan kendisi;
                      // members map'inden de yalnız kendi anahtarı silinir.
                      (request.auth.uid in resource.data.memberIds
                       && request.auth.uid != resource.data.ownerId
                       && !(request.auth.uid in request.resource.data.memberIds)
                       && resource.data.memberIds.hasAll(request.resource.data.memberIds)
                       && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
                       && request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['memberIds', 'members', 'updatedAt'])
                       && request.resource.data.members.diff(resource.data.members)
                            .removedKeys().hasOnly([request.auth.uid])
                       && request.resource.data.members.diff(resource.data.members)
                            .addedKeys().size() == 0
                       && request.resource.data.members.diff(resource.data.members)
                            .changedKeys().size() == 0)
                    );

      allow delete: if isSignedIn() && request.auth.uid == resource.data.ownerId;

      match /items/{itemKey} {
        allow read: if isSignedIn()
                    && request.auth.uid in sharedList(listId).memberIds;
        allow create: if isSignedIn()
                      && request.auth.uid in sharedList(listId).memberIds
                      && request.resource.data.addedBy == request.auth.uid
                      && (request.auth.uid == sharedList(listId).ownerId
                          || sharedList(listId).members[request.auth.uid].canAdd == true);
        allow delete: if isSignedIn()
                      && request.auth.uid in sharedList(listId).memberIds
                      && (request.auth.uid == sharedList(listId).ownerId
                          || resource.data.addedBy == request.auth.uid
                          || sharedList(listId).members[request.auth.uid].canRemove == true);
        allow update: if false; // öğeler değişmez — sil + yeniden ekle
      }
    }

    // ─── Cloud Function'ın sahibi olduğu kullanıcı dokümanları ──────────
    // AiUsage ve ProviderWatch'u yalnız admin SDK yazar; istemci okur.
    // TEK istisna hesap silme: doküman uid ile anahtarlandığı için hesap
    // gittikten sonra kalması kişisel veri artığı olurdu (hesap silme
    // uyumluluğu). Ama koşulsuz bir delete izni AiUsage'da "sil = günlük AI
    // kotasını sıfırla" exploit'i açardı — bu yüzden silme YALNIZ profil
    // dokümanı artık yokken serbest. Normal kullanımda Users/{uid} her zaman
    // vardır; purge ise AiUsage'a Users/{uid}'i sildikten SONRA dokunur
    // (services/accountService.js sonundaki sıralama buna dayanır).
    function profileGone(uid) {
      return !exists(/databases/$(database)/documents/Users/$(uid));
    }
    match /AiUsage/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if false;
      allow delete: if isOwner(uid) && profileGone(uid);
    }

    // ─── Streaming uygunluk snapshot'ı (dailyStreamingAvailability yazar) ──
    match /ProviderWatch/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if false;
      allow delete: if isOwner(uid) && profileGone(uid);
    }

    // ─── Kullanıcı profili ──────────────────────────────────────────────
    // Doğum tarihi BİR KEZ yazılır. Yetişkin içerik kapısı (utils/ageGate.js)
    // yaşı bu alandan türettiği için, 18 altı çıkan kullanıcı tarihi
    // düzeltip kapıyı açamamalı. Alanı hiç olmayan (bu özellikten önceki)
    // hesaplar bir kez yazabilir; alanı SİLMEK de değişiklik sayılır.
    // Profil ekranındaki alan da dolu geldiğinde salt-okunur
    // (screens/tabs/profile/EditProfileScreen.js).
    // Her iki taraf da .get() ile okunuyor: alan yokken `resource.data.birthDate`
    // değerlendirme HATASI fırlatıyor ve hata, kuralın geri kalanını da
    // düşürebiliyor (hata = red). Varsayılanlı okuma temiz `false` üretir.
    function birthDateKept() {
      return !('birthDate' in resource.data)
          || request.resource.data.get('birthDate', '') == resource.data.get('birthDate', '');
    }
    match /Users/{uid} {
      allow read: if isSignedIn();
      // RevenueCat entitlement alanını yalnız Admin SDK webhook'u yazar.
      // Kullanıcı profil oluştururken veya güncellerken kendini premium yapamaz.
      allow create: if isOwner(uid)
                    && !request.resource.data.keys().hasAny(['entitlements']);
      // Sahibi her şeyi yazar; diğer signed-in kullanıcılar SADECE
      // counter/timestamp alanlarını günceller (friend req / like / comment
      // akışlarında karşı tarafın dokümanı güncellenir).
      // counterOk: her sayaç en fazla ±1 oynayabilir → keyfî değer yazımı
      // (troll'ün sayaç şişirmesi) kural düzeyinde engellenir.
      allow update: if (isOwner(uid)
                        && !request.resource.data.diff(resource.data)
                          .affectedKeys().hasAny(['entitlements'])
                        && birthDateKept())
                    || (isSignedIn()
                        && onlyUpdating([
                             'friendsCount','followersCount','followingCount',
                             'pendingRequestsInCount','pendingRequestsOutCount',
                             'unreadNotifsCount','updatedAt'
                           ])
                        && counterOk('friendsCount')
                        && counterOk('followersCount')
                        && counterOk('followingCount')
                        && counterOk('pendingRequestsInCount')
                        && counterOk('pendingRequestsOutCount')
                        && counterOk('unreadNotifsCount'));
      allow delete: if isOwner(uid);
    }

    // Webhook tekrarlarını idempotent yapan kayıtlar yalnız Admin SDK'ya ait.
    match /RevenueCatWebhookEvents/{eventId} {
      allow read, write: if false;
    }

    // friends subcollection — sahibi okur; sahibi VEYA arkadaşın kendisi
    // (cross-write için) yazabilir / silebilir.
    match /Users/{uid}/friends/{friendUid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
                    || (isSignedIn() && request.auth.uid == friendUid);
      allow delete: if isOwner(uid)
                    || (isSignedIn() && request.auth.uid == friendUid);
      // Profil değişiminde karşı tarafın listesindeki KENDİ kaydımı (doc id ==
      // benim uid'im) güncelleyebilmem için (friendName/friendAvatarIndex).
      allow update: if isOwner(uid)
                    || (isSignedIn() && request.auth.uid == friendUid);
    }

    // conversations subcollection — 1-1 sohbet "gelen kutusu" index'i.
    // Sahibi okur; sahibi VEYA karşı taraf (doc id == karşı uid) yazar — her
    // mesajda iki tarafın da girişi güncellenir (denormalize lastMessage).
    match /Users/{uid}/conversations/{otherUid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
                   || (isSignedIn() && request.auth.uid == otherUid);
    }

    // ─── Friend requests (incoming) ─────────────────────────────────────
    // Eski v1: friendRequests bir map alanıydı (Users/{uid}.friendRequests).
    // Yeni v2: subcollection /friendRequests/{requestId}
    // Eski client'larda /friendRequests/{rid} ile rid'le erişiliyor olabilir,
    // o yüzden kural her ikisini de kapsayacak şekilde.
    match /Users/{uid}/friendRequests/{reqId} {
      allow read: if isOwner(uid);
      // Yeni model: fromUid alanı request.auth.uid'e eşit olmalı.
      // Engelli kullanıcı istek atamaz.
      allow create: if isSignedIn()
                    && request.resource.data.fromUid == request.auth.uid
                    && notBlocked(uid);
      // Sahibi (alıcı) okur/günceller/siler;
      // Gönderen istek geri alabilmek için silebilir.
      allow update, delete: if isOwner(uid)
                            || (isSignedIn() &&
                                resource.data.fromUid == request.auth.uid);
    }

    // ─── Sent requests (outgoing kopyası) ───────────────────────────────
    match /Users/{uid}/sentRequests/{reqId} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid);
      // Sahibi siler (cancel) veya alıcı kabul ederken siler (cross-write).
      allow delete: if isOwner(uid)
                    || (isSignedIn() &&
                        resource.data.toUid == request.auth.uid);
    }

    // ─── Blocked ────────────────────────────────────────────────────────
    match /Users/{uid}/blocked/{blockedUid} {
      allow read, write: if isOwner(uid);
    }

    // ─── Gizli kullanıcı verisi (yalnız sahibi) ─────────────────────────
    // Users/{uid} kök dokümanı TÜM oturumlulara okunur (profil kartları,
    // arkadaş listeleri). Bu yüzden başkasının görmemesi gereken hiçbir alan
    // orada duramaz. Expo push token'ları buraya taşındı: kökte dururken
    // herhangi bir kullanıcı tüm token'ları dökebiliyor ve Expo push ucundan
    // herkese sahte bildirim atabiliyordu (private/push).
    match /Users/{uid}/private/{docId} {
      allow read, write: if isOwner(uid);
    }

    // ─── Following / Followers / Liked / Bookmarks (Posts için) ─────────
    match /Users/{uid}/following/{targetUid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid);
      // Silme: liste sahibi VEYA takip edilen kişi. İkincisi hesap silme
      // purge'unda "beni takip edenlerin following kaydını temizle" adımı
      // için gerekli — aksi halde silinen hesap sonsuza dek takipte görünür.
      allow delete: if isOwner(uid) || isOwner(targetUid);
    }
    match /Users/{uid}/followers/{followerUid} {
      allow read: if isSignedIn();
      // followers dokümanını "followerUid" sahibi yazar (cross-write).
      allow create: if isOwner(followerUid);
      // Silme: takipçinin kendisi VEYA liste sahibi (hesap silme purge'unda
      // kendi followers koleksiyonunu temizleyebilmesi için).
      allow delete: if isOwner(followerUid) || isOwner(uid);
    }
    match /Users/{uid}/likedPosts/{postId} {
      allow read, create, delete: if isOwner(uid);
    }
    match /Users/{uid}/bookmarks/{postId} {
      allow read, write: if isOwner(uid);
    }
    // "Puanladıklarım" — kullanıcının verdiği oyların denormalize kopyası.
    match /Users/{uid}/myRatings/{mediaKey} {
      allow read, write: if isOwner(uid);
    }
    // "Yorumlarım" — kullanıcının yazdığı yorumların denormalize kopyası.
    match /Users/{uid}/myComments/{commentId} {
      allow read, write: if isOwner(uid);
    }

    // ─── Notifications ──────────────────────────────────────────────────
    // ÖNEMLI: kodda alan adı `fromUid` (eskiden `fromUserId` yazılmıştı).
    match /Users/{uid}/notifications/{notifId} {
      allow read: if isOwner(uid);
      // notBlocked: engellediğim kullanıcı bana bildirim yazamaz (push spam /
      // spoof kapısı — friendRequests'teki kontrolün aynısı).
      allow create: if isSignedIn()
                    && request.resource.data.fromUid == request.auth.uid
                    && notBlocked(uid);
      // Sahibi sadece 'read' alanını değiştirebilir veya silebilir.
      allow update: if isOwner(uid) && onlyUpdating(['read']);
      allow delete: if isOwner(uid);
    }

    // ─── Notlar / Hatırlatıcılar / İstatistikler ────────────────────────
    match /Notes/{uid}/{document=**} {
      allow read, write: if isOwner(uid);
    }
    match /Reminders/{uid}/{document=**} {
      allow read, write: if isOwner(uid);
    }
    match /UserStats/{uid} {
      allow read, write: if isOwner(uid);
    }
    match /SceneGame/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid);
    }
    // Soru gecmisi leaderboard belgesinden ayridir ve yalnizca sahibine aittir.
    match /SceneGameHistory/{uid} {
      allow read, write: if isOwner(uid);
    }

    // ─── Part 16 - Yeni oyun veri modeli (additive, SceneGame'i degistirmez) ──
    // Kisisel ozet/istatistik/oturum belgeleri: SceneGame/SceneGameHistory ile
    // ayni guven modeli (sahibi okur/yazar; bu fazda backend olmadigi icin
    // sunucu tarafi dogrulama yok — Part 17 bulgusu burada da gecerlidir).
    match /Users/{uid}/gameProfile/{docId} {
      allow read, write: if isOwner(uid);
    }
    match /Users/{uid}/gameStats/{gameId} {
      allow read, write: if isOwner(uid);
    }
    // Oturum kayitlari da SceneGameHistory gibi sahibine ozeldir; SceneGame
    // veya SceneGameHistory'de mevcut bir "create-only" kisitlama olmadigi
    // icin (ikisi de owner read/write) burada da duz owner read/write
    // kullanildi (tutarlilik).
    match /Users/{uid}/gameSessions/{sessionId} {
      allow read, write: if isOwner(uid);
    }

    // ─── Part 16.4 - Liderlik (yeni model) ──────────────────────────────
    // SceneGame'deki mevcut leaderboard kuraliyla (herkes okur, sahibi
    // yazar) ayni guven modeli; istemci sadece KENDI uid'ine yazabilir.
    match /GameLeaderboards/{boardId}/entries/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid);
    }

    // ─── Film / dizi yorumları ──────────────────────────────────────────
    // Sahibi metnini düzenler ve siler. Sahibi OLMAYAN kullanıcı yalnız
    // sayaç/beğeni alanlarına dokunabilir — Posts/{postId}/comments'taki
    // counterOk deseninin aynısı:
    //   • likeCount ±1 + likedBy'da YALNIZ kendi anahtarı (başkasının
    //     beğenisini silmek / haritayı ezmek engellenir),
    //   • replyCount ±1: yanıtı ekleyen/silen kişi ÜST yorumun sayacını
    //     günceller — üst yorum başkasınınsa bu izin olmadan sayaç sonsuza
    //     dek şişik kalırdı (components/Comment.js + hesap silme purge'u).
    function mediaCommentCounterOk() {
      return onlyUpdating(['likeCount', 'likedBy', 'replyCount'])
          && counterOk('likeCount')
          && counterOk('replyCount')
          && request.resource.data.get('likedBy', {})
               .diff(resource.data.get('likedBy', {}))
               .affectedKeys().hasOnly([request.auth.uid]);
    }
    // Yorumu yazan, dokümandaki userId olmak ZORUNDA. Aksi halde herkes
    // başkasının adına yorum açabilirdi — üstelik düzenleme/silme kuralları da
    // bu alana baktığı için sahte yorum kurbanın üstüne kilitlenir, kurban onu
    // silemezdi. (Posts create'teki authorId kuralının aynısı.)
    function ownMediaComment() {
      return request.resource.data.userId == request.auth.uid;
    }
    match /MovieComment/{movieId}/comments/{commentId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn() && ownMediaComment();
      allow update: if isSignedIn()
                    && (request.auth.uid == resource.data.userId
                        || mediaCommentCounterOk());
      allow delete: if isSignedIn() && request.auth.uid == resource.data.userId;
    }
    match /MovieComment/{movieId}/comments/{commentId}/replies/{replyId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn() && ownMediaComment();
      allow update: if isSignedIn()
                    && (request.auth.uid == resource.data.userId
                        || mediaCommentCounterOk());
      allow delete: if isSignedIn() && request.auth.uid == resource.data.userId;
    }

    // ─── Dizi yorumları (film ile birebir aynı yapı) ────────────────────
    match /TvComment/{tvId}/comments/{commentId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn() && ownMediaComment();
      allow update: if isSignedIn()
                    && (request.auth.uid == resource.data.userId
                        || mediaCommentCounterOk());
      allow delete: if isSignedIn() && request.auth.uid == resource.data.userId;
    }
    match /TvComment/{tvId}/comments/{commentId}/replies/{replyId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn() && ownMediaComment();
      allow update: if isSignedIn()
                    && (request.auth.uid == resource.data.userId
                        || mediaCommentCounterOk());
      allow delete: if isSignedIn() && request.auth.uid == resource.data.userId;
    }

    // ─── Derecelendirmeler (film + dizi, TMDB ile hybrid) ───────────────
    // Ratings/{mediaKey}  → agregat sayaçlar (count / sum). Tek doküman
    // olduğu için HERKESE yazılabilir olmak zorunda; kısıt "kim" değil "ne
    // kadar" tarafında: yazım, kullanıcının KENDİ oyunun aynı yazımdaki
    // değişimiyle birebir uyuşmalı. services/ratingsService.js iki dokümanı
    // tek runTransaction içinde yazdığı için kural commit SONRASI durumu
    // (getAfter) okuyup farkı doğrulayabiliyor. Böylece oy vermeden sayaç
    // oynatmak ya da sum'ı şişirmek (skor manipülasyonu) mümkün değil.
    //
    // TAM EŞİTLİK aranıyor. Agregatı gerçek oylarla uyumsuz kalmış bir
    // doküman olursa ratingsService'teki Math.max(0, …) kırpması eşitliği
    // bozar ve o içerik puanlanamaz hâle gelir — çözüm konsoldan o tek
    // dokümanı onarmak.
    function myRatingPath(key) {
      return /databases/$(database)/documents/Ratings/$(key)/userRatings/$(request.auth.uid);
    }
    // Kendi oyumun bu yazımdaki değişimi; oy yoksa 0 sayılır.
    function myRatingDelta(key) {
      return (existsAfter(myRatingPath(key)) ? getAfter(myRatingPath(key)).data.rating : 0)
           - (exists(myRatingPath(key)) ? get(myRatingPath(key)).data.rating : 0);
    }
    // Oy sayısının değişimi: yeni oy +1, kaldırma -1, oyu değiştirme 0.
    function myRatingCountDelta(key) {
      return (existsAfter(myRatingPath(key)) ? 1 : 0)
           - (exists(myRatingPath(key)) ? 1 : 0);
    }
    match /Ratings/{mediaKey} {
      allow read: if true;

      // İlk oy: doküman yokken açılıyor, dolayısıyla count 1 ve sum verilen oy.
      // Alanlar .get() ile okunuyor — eksik alan hata değil temiz `false` versin.
      allow create: if isSignedIn()
                    && request.resource.data.keys()
                         .hasOnly(['mediaType', 'mediaId', 'count', 'sum', 'updatedAt'])
                    && request.resource.data.get('count', 0) == 1
                    && myRatingCountDelta(mediaKey) == 1
                    && request.resource.data.get('sum', -1) == myRatingDelta(mediaKey);

      allow update: if isSignedIn()
                    && onlyUpdating(['mediaType', 'mediaId', 'count', 'sum', 'updatedAt'])
                    && request.resource.data.get('count', -1) is int
                    && request.resource.data.get('count', -1) >= 0
                    && request.resource.data.get('sum', -1) is number
                    && request.resource.data.get('sum', -1) >= 0
                    && request.resource.data.get('count', -1) - resource.data.get('count', 0)
                         == myRatingCountDelta(mediaKey)
                    && request.resource.data.get('sum', -1) - resource.data.get('sum', 0)
                         == myRatingDelta(mediaKey);

      // Agregat silme yok: bir kullanıcının silinmesi diğerlerinin oylarını
      // götürmemeli (hesap silme purge'u removeMyRating ile düşüm yapar).
      allow delete: if false;

      match /userRatings/{uid} {
        allow read:                 if true;
        allow create, update, delete: if isOwner(uid);
      }
    }

    // ─── Posts (sosyal feed) ────────────────────────────────────────────
    match /Posts/{postId} {
      allow read: if true;

      allow create: if isSignedIn()
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.likesCount == 0
                    && request.resource.data.commentsCount == 0;

      // counterOk: sahibi olmayan kullanıcı sayaçları en fazla ±1 oynatabilir
      // (istemci increment(±1) kullanır) — keyfî likesCount yazıp "top" feed'i
      // manipüle etmek kural düzeyinde engellenir.
      allow update: if isOwner(resource.data.authorId)
                    || (isSignedIn() &&
                        onlyUpdating(['likesCount', 'commentsCount', 'updatedAt'])
                        && counterOk('likesCount')
                        && counterOk('commentsCount'))
                    // Anket oyu: sahibi olmayan kullanıcı YALNIZ poll.votes'u ve
                    // yalnız KENDİ oy anahtarını değiştirebilir (grup poll deseni).
                    || (isSignedIn()
                        && onlyUpdating(['poll'])
                        && resource.data.poll is map
                        && request.resource.data.poll.diff(resource.data.poll).affectedKeys().hasOnly(['votes'])
                        && request.resource.data.poll.votes.diff(resource.data.poll.votes).affectedKeys().hasOnly([request.auth.uid]));

      allow delete: if isOwner(resource.data.authorId);

      match /likes/{userId} {
        allow read: if true;
        allow create: if isOwner(userId);
        // Silme: beğeni sahibi VEYA post sahibi. Post sahibi izni hesap silme
        // purge'u için şart: postu silmeden önce alt koleksiyon temizlenirken
        // başkalarının beğeni dokümanları da silinebilmeli (aksi halde batch
        // permission-denied ile düşer ve post asla silinemezdi).
        allow delete: if isOwner(userId)
                      || (isSignedIn()
                          && request.auth.uid
                             == get(/databases/$(database)/documents/Posts/$(postId)).data.authorId);
      }

      match /comments/{commentId} {
        allow read:   if isSignedIn();
        allow create: if isSignedIn()
                      && request.resource.data.authorId == request.auth.uid;
        // Sahibi her şeyi güncelleyebilir/silebilir; sahibi olmayan kullanıcı
        // SADECE beğeni alanlarını (likesCount / likedBy) güncelleyebilir —
        // likesCount ±1 ve likedBy'da YALNIZ kendi anahtarı (poll.votes deseni):
        // başkalarının beğenilerini silmek/haritayı ezmek engellenir.
        allow update: if isSignedIn()
                      && (request.auth.uid == resource.data.authorId
                          || (onlyUpdating(['likesCount', 'likedBy'])
                              && counterOk('likesCount')
                              && request.resource.data.get('likedBy', {})
                                   .diff(resource.data.get('likedBy', {}))
                                   .affectedKeys().hasOnly([request.auth.uid])));
        // Silme: yorum sahibi VEYA post sahibi (kendi postundaki yorumları
        // yönetebilir; hesap silme purge'u da buna dayanır) VEYA üst yorumu
        // aynı batch'te silinen yanıt (kaskatlı temizlik: existsAfter batch
        // SONRASI durumu görür — üst yorumu silme yetkisi olmayan biri bu
        // yoldan yanıt silemez).
        allow delete: if isSignedIn()
                      && (request.auth.uid == resource.data.authorId
                          || request.auth.uid
                             == get(/databases/$(database)/documents/Posts/$(postId)).data.authorId
                          || (resource.data.parentId is string
                              && !existsAfter(/databases/$(database)/documents/Posts/$(postId)/comments/$(resource.data.parentId))));
      }
    }

    // ─── Post şikayetleri (moderasyon) ──────────────────────────────────
    // Yalnız create: giriş yapmış kullanıcı kendi uid'iyle şikayet yazar.
    // Okuma/güncelleme/silme istemciye kapalı — inceleme konsoldan yapılır.
    match /PostReports/{reportId} {
      allow read, update, delete: if false;
      allow create: if isSignedIn()
                    && request.resource.data.reporterId == request.auth.uid;
    }

    // ─── İçerik şikayetleri: yorum / mesaj / kullanıcı ───────────────────
    // PostReports ile AYNI model (create-only). Ayrı koleksiyon çünkü şema
    // farklı: gönderi şikayeti postId taşıyor, buradakiler hedefin tam
    // Firestore yolunu + kısa önizlemesini taşıyor. PostReports'a
    // dokunulmadı; gönderi şikayetleri orada kalmaya devam ediyor.
    //
    // Okuma da KAPALI: şikayet edilen kişi kendisi hakkındaki şikayetleri
    // görmesin ve koleksiyon "kim kimi ihbar etti" veri tabanına dönüşmesin.
    // İnceleme konsoldan (iç moderasyon görünümü: yol haritası D5).
    //
    // Alan listesi ve tipler sıkı doğrulanıyor; istemci tarafındaki karşılığı
    // utils/reportValidation.js (testli) — ikisi birlikte değişmeli.
    match /ContentReports/{reportId} {
      allow read, update, delete: if false;
      allow create: if isSignedIn()
                    && request.resource.data.reporterId == request.auth.uid
                    && request.resource.data.keys().hasOnly([
                         'type', 'targetPath', 'targetPreview',
                         'targetUserId', 'reporterId', 'reason', 'createdAt'
                       ])
                    && request.resource.data.type in ['comment', 'message', 'user']
                    && request.resource.data.targetUserId is string
                    && request.resource.data.targetUserId != request.auth.uid
                    && request.resource.data.targetPath is string
                    && request.resource.data.targetPath.size() <= 500
                    && request.resource.data.reason is string
                    && request.resource.data.reason.size() <= 40
                    && request.resource.data.targetPreview is string
                    && request.resource.data.targetPreview.size() <= 300;
    }

    // ─── Presence (online status, ayrı koleksiyon) ──────────────────────
    // Heartbeat'i Users üzerindeki listener fan-out'undan kaçırmak için
    // ayrı koleksiyon. Tüm signed-in kullanıcılar okur (privacy filtresi
    // UI tarafında); sadece sahibi yazar.
    match /Presence/{uid} {
      allow read: if isSignedIn();
      allow create, update, delete: if isOwner(uid);
    }


    // ─── Usernames (uniqueness için reservation) ────────────────────────
    match /Usernames/{usernameLower} {
      allow read: if true;       // checkUsername & arama için
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      // Update yok — username değişimi delete+create transaction'ı.
    }

    // ─── Sohbetler ──────────────────────────────────────────────────────
    // chatId = "uid1_uid2" (sıralı, ChatScreen kurar). Üyelik kontrolü
    // substring yerine TAM segment eşleşmesiyle (isChatMember) yapılır.
    // read'e participants tabanlı ikinci yol eklendi: doc-ID'den türetilen
    // kural collection query'lerde kanıtlanamadığı için
    // where("participants","array-contains",uid) sorgusu (hesap silme
    // purge'u) aksi halde her zaman permission-denied alırdı.
    match /chats/{chatId} {
      allow read: if isChatMember(chatId)
                  || (isSignedIn() && request.auth.uid in resource.data.participants);
      allow write: if isChatMember(chatId);
    }
    match /chats/{chatId}/messages/{msgId} {
      allow read: if isChatMember(chatId);
      // Mesajı yazan kendi uid'ini koymak ZORUNDA; aksi halde sohbetteki taraf
      // karşısındakinin ağzından mesaj uydurabilirdi. Grup mesajlarında kural
      // zaten böyle (groups/{groupId}/messages).
      allow create: if isChatMember(chatId)
                    && request.resource.data.senderId == request.auth.uid;
      // "Yalnız gönderen günceller" DEĞİL: üç meşru güncellemenin ikisi karşı
      // tarafın dokümanına dokunuyor (bkz. screens/chat/ChatScreen.js).
      //   • gönderen kendi mesajının metnini düzenler,
      //   • makbuz: gönderen kendi mesajına "delivered", ALICI "seen" yazar,
      //   • ankette herkes yalnız KENDİ oy anahtarını değiştirir.
      // Alan okumaları .get()/`in` ile korunuyor: eksik alan değerlendirme
      // HATASI fırlatırsa hata kuralın tamamını düşürebiliyor, yani meşru bir
      // dal hiç denenmeden yazma reddedilebiliyor.
      allow update: if isChatMember(chatId)
                    && (
                      (resource.data.get('senderId', '') == request.auth.uid
                       && onlyUpdating(['text', 'edited']))
                      || (resource.data.get('senderId', '') == request.auth.uid
                          && onlyUpdating(['status', 'deliveredAt'])
                          && request.resource.data.get('status', '') == 'delivered')
                      || (resource.data.get('senderId', '') != request.auth.uid
                          && onlyUpdating(['status'])
                          && request.resource.data.get('status', '') == 'seen')
                      || ('poll' in resource.data
                          && onlyUpdating(['poll'])
                          && request.resource.data.poll.diff(resource.data.poll)
                               .affectedKeys().hasOnly(['votes'])
                          && request.resource.data.poll.get('votes', {})
                               .diff(resource.data.poll.get('votes', {}))
                               .affectedKeys().hasOnly([request.auth.uid]))
                    );
      // Silme GÖNDERENE değil ÜYEYE bağlı: hesap silme purge'u sohbeti
      // kapatırken karşı tarafın mesajlarını da temizlemek zorunda
      // (services/accountService.js), yoksa silinen hesabın sohbetleri asla
      // boşaltılamaz ve kişisel veri artığı kalır. Sunucu tarafı süpürücü
      // (yol haritası D7) geldiğinde burası senderId şartına inecek.
      allow delete: if isChatMember(chatId);
    }
    match /chats/{chatId}/pins/{pinId} {
      allow read: if isChatMember(chatId);
      allow create: if isChatMember(chatId)
                    && request.resource.data.messageId == pinId
                    && request.resource.data.pinnedBy == request.auth.uid
                    && exists(/databases/$(database)/documents/chats/$(chatId)/messages/$(pinId))
                    && request.resource.data.senderId
                       == get(/databases/$(database)/documents/chats/$(chatId)/messages/$(pinId)).data.senderId
                    && request.resource.data.keys().hasOnly([
                      'messageId', 'senderId', 'senderName', 'preview', 'kind',
                      'pinnedBy', 'pinnedByName', 'pinnedAt'
                    ]);
      allow delete: if isChatMember(chatId)
                    && (
                      resource.data.pinnedBy == request.auth.uid
                      || get(/databases/$(database)/documents/chats/$(chatId)/messages/$(pinId)).data.senderId == request.auth.uid
                    );
    }

    // ─── Gruplar ────────────────────────────────────────────────────────
    function groupMembers(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)).data.members;
    }
    function isGroupCreator(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy
             == request.auth.uid;
    }
    function isGroupAdmin(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)).data.admins is list
             && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.admins;
    }
    function isGroupManager(groupId) {
      return isGroupCreator(groupId) || isGroupAdmin(groupId);
    }
    match /groups/{groupId} {
      allow read:   if isSignedIn() && request.auth.uid in resource.data.members;
      allow create: if isSignedIn()
                    && request.resource.data.createdBy == request.auth.uid
                    && request.auth.uid in request.resource.data.members
                    && request.resource.data.admins is list
                    && request.resource.data.admins.size() == 0;
      // Sıradan üyeler yalnız mesaj özetini günceller. Üye/grup yönetimi
      // kurucu veya admins listesindeki kullanıcılarla sınırlıdır.
      allow update: if isSignedIn()
                    && request.auth.uid in resource.data.members
                    && (
                      request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['lastMessage', 'updatedAt'])
                      || (
                        (
                          request.auth.uid == resource.data.createdBy
                          || (resource.data.admins is list
                              && request.auth.uid in resource.data.admins)
                        )
                        && request.resource.data.createdBy == resource.data.createdBy
                        && resource.data.createdBy in request.resource.data.members
                        && (
                          request.resource.data.admins == resource.data.admins
                          || (
                            request.auth.uid == resource.data.createdBy
                            && request.resource.data.members.hasAll(request.resource.data.admins)
                          )
                        )
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly([
                               'members', 'memberInfo', 'admins', 'updatedAt',
                               'name', 'color', 'avatarIndex'
                             ])
                      )
                      // Üye KENDİNİ çıkarır (gruptan ayrılma + hesap silme
                      // purge'u). Yalnız ayrılanın kendi izleri silinebilir:
                      // başkası çıkarılamaz, yeni üye/yönetici eklenemez.
                      || (
                        !(request.auth.uid in request.resource.data.members)
                        && resource.data.members.hasAll(request.resource.data.members)
                        && request.resource.data.members.size()
                             == resource.data.members.size() - 1
                        && !(request.auth.uid in request.resource.data.get('admins', []))
                        && resource.data.get('admins', [])
                             .hasAll(request.resource.data.get('admins', []))
                        && request.resource.data.get('memberInfo', {})
                             .diff(resource.data.get('memberInfo', {}))
                             .affectedKeys().hasOnly([request.auth.uid])
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['members', 'memberInfo', 'admins',
                                       'createdBy', 'updatedAt'])
                        && (
                          // Sıradan üye / yönetici ayrılıyor → kurucu değişmez.
                          (request.auth.uid != resource.data.createdBy
                           && request.resource.data.createdBy == resource.data.createdBy)
                          ||
                          // KURUCU ayrılıyor → sahiplik KALAN bir üyeye geçmek
                          // ZORUNDA. Aksi halde yukarıdaki yönetim dalı
                          // ('createdBy in members' şartı) bir daha asla
                          // sağlanamaz ve grup yönetilemez hâle gelirdi.
                          // Grupta kimse kalmıyorsa istemci grubu siler.
                          (request.auth.uid == resource.data.createdBy
                           && request.resource.data.createdBy != request.auth.uid
                           && (request.resource.data.createdBy in request.resource.data.members))
                        )
                      )
                    );
      allow delete: if isSignedIn() && request.auth.uid == resource.data.createdBy;

      match /messages/{msgId} {
        allow read:   if isSignedIn() && request.auth.uid in groupMembers(groupId);
        allow create: if isSignedIn()
                      && request.auth.uid in groupMembers(groupId)
                      && request.resource.data.senderId == request.auth.uid;
        // Gönderen yalnız kendi düz mesaj metnini düzenler. Diğer üyeler bir
        // ankette yalnız votes haritasını değiştirebilir; mesajın sorusu,
        // seçenekleri, göndereni veya alıntı metası değiştirilemez.
        allow update: if isSignedIn()
                      && request.auth.uid in groupMembers(groupId)
                      && (
                        (
                          resource.data.senderId == request.auth.uid
                          && request.resource.data.diff(resource.data).affectedKeys()
                               .hasOnly(['text', 'edited'])
                        )
                        || (
                          resource.data.kind == 'poll'
                          && request.resource.data.diff(resource.data).affectedKeys()
                               .hasOnly(['poll'])
                          && request.resource.data.poll.diff(resource.data.poll).affectedKeys()
                               .hasOnly(['votes'])
                        )
                      );
        allow delete: if isSignedIn()
                      && (
                        resource.data.senderId == request.auth.uid
                        || isGroupCreator(groupId)
                      );
      }

      match /pins/{pinId} {
        allow read: if isSignedIn() && request.auth.uid in groupMembers(groupId);
        allow create: if isSignedIn()
                      && request.auth.uid in groupMembers(groupId)
                      && isGroupManager(groupId)
                      && request.resource.data.messageId == pinId
                      && request.resource.data.pinnedBy == request.auth.uid
                      && exists(/databases/$(database)/documents/groups/$(groupId)/messages/$(pinId))
                      && request.resource.data.senderId
                         == get(/databases/$(database)/documents/groups/$(groupId)/messages/$(pinId)).data.senderId
                      && request.resource.data.keys().hasOnly([
                        'messageId', 'senderId', 'senderName', 'preview', 'kind',
                        'pinnedBy', 'pinnedByName', 'pinnedAt'
                      ]);
        allow delete: if isSignedIn()
                      && request.auth.uid in groupMembers(groupId)
                      && (
                        resource.data.pinnedBy == request.auth.uid
                        || isGroupCreator(groupId)
                        || get(/databases/$(database)/documents/groups/$(groupId)/messages/$(pinId)).data.senderId == request.auth.uid
                      );
      }
    }

    // ─── Aylık Turnuva (topluluk oylaması) ──────────────────────────────
    // tournaments/{periodId}: ay başına bir turnuva (tür + 64 aday havuzu).
    // Aday listesi ilk açan istemci tarafından BİR KEZ yazılır (deterministik),
    // sonra değişmez. Oylar alt-koleksiyonda kullanıcı başına TEK doküman.
    //
    // OY MODELİ (kural düzeyinde uygulanır — çok kullanıcı güvenliği):
    //   • Seçim fazı (gün 0-7): kullanıcı başına TEK aday hype'ı (noms, 1 anahtar).
    //   • Eleme (gün 7-21): maç başına TEK oy; picks'e yalnız YENİ anahtar
    //     eklenebilir (lastKey ile bildirilir), mevcut oy DEĞİŞTİRİLEMEZ/SİLİNEMEZ.
    //   • Her turun oyu yalnız o turun zaman penceresinde yazılabilir
    //     (tournamentEngine.ROUNDS takvimiyle birebir: r32 7-9, r16 9-11,
    //      qf 11-13, sf 13-15, final 15-21). Pencere dışı yazım reddedilir —
    //     geçmişe/geleceğe oy enjeksiyonu bracket'i değiştiremez.
    //   NOT: __DEV__ faz önizleme (setDebugNow) gerçek yazımları bu pencerelere
    //   takılır; dev'de oy testi yalnız gerçek takvim penceresinde çalışır.
    // tournamentWinners/{periodId}: biten ayların podyum arşivi (yıl + ay ile).
    // YALNIZ Cloud Function yazar (archiveTournamentWinners; Admin SDK kuralları
    // es geçer). İstemciye yazma AÇILMAZ: burası kalıcı bir kayıt, istemci
    // yazımı sahte şampiyon enjeksiyonuna açık olurdu.
    match /tournamentWinners/{periodId} {
      allow read:  if isSignedIn();
      allow write: if false;
    }

    match /tournaments/{periodId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.createdBy == request.auth.uid;
      // Aday/seed verisi değişmez; yalnız oluşturan kurtarma için yazar/siler.
      allow update, delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;

      // Ay başlangıcı (ms) — pencere hesapları turnuva dokümanından okunur.
      function tournStart() {
        return get(/databases/$(database)/documents/tournaments/$(periodId)).data.startAtMs;
      }
      function inWindow(fromDay, toDay) {
        return request.time.toMillis() >= tournStart() + fromDay * 86400000
            && request.time.toMillis() <  tournStart() + toDay   * 86400000;
      }
      // matchId ("r32_5" gibi) → o turun oy penceresi.
      function pickWindowOk(key) {
        return (key.matches('r32_[0-9]+')   && inWindow(7, 9))
            || (key.matches('r16_[0-9]+')   && inWindow(9, 11))
            || (key.matches('qf_[0-9]+')    && inWindow(11, 13))
            || (key.matches('sf_[0-9]+')    && inWindow(13, 15))
            || (key.matches('final_[0-9]+') && inWindow(15, 21));
      }
      // Yazılan pick değeri 'a' | 'b' olmalı.
      function pickValueOk(key) {
        return request.resource.data.picks[key] == 'a'
            || request.resource.data.picks[key] == 'b';
      }

      match /votes/{voterUid} {
        allow read: if isSignedIn();
        allow delete: if false; // oylar kalıcıdır

        // create: tek yazımda TEK oy — ya 1 aday hype'ı ya 1 maç oyu.
        allow create: if isOwner(voterUid)
          && request.resource.data.keys().hasOnly(['uid','noms','picks','lastKey','updatedAt'])
          && request.resource.data.uid == voterUid
          && (
            ( request.resource.data.get('noms', {}).size() == 1
              && request.resource.data.get('picks', {}).size() == 0
              && inWindow(0, 7) )
            ||
            ( request.resource.data.get('noms', {}).size() == 0
              && request.resource.data.get('picks', {}).size() == 1
              && request.resource.data.lastKey is string
              && request.resource.data.picks.keys().hasOnly([request.resource.data.lastKey])
              && pickValueOk(request.resource.data.lastKey)
              && pickWindowOk(request.resource.data.lastKey) )
          );

        // update: mevcut oylar değiştirilemez/silinemez; tek seferde tek YENİ oy.
        allow update: if isOwner(voterUid)
          && request.resource.data.keys().hasOnly(['uid','noms','picks','lastKey','updatedAt'])
          && request.resource.data.get('noms', {})
               .diff(resource.data.get('noms', {})).removedKeys().size() == 0
          && request.resource.data.get('noms', {})
               .diff(resource.data.get('noms', {})).changedKeys().size() == 0
          && request.resource.data.get('picks', {})
               .diff(resource.data.get('picks', {})).removedKeys().size() == 0
          && request.resource.data.get('picks', {})
               .diff(resource.data.get('picks', {})).changedKeys().size() == 0
          && (
            ( // yeni aday hype'ı: tek hak — daha önce hiç kullanmamış olmalı
              request.resource.data.get('noms', {})
                .diff(resource.data.get('noms', {})).addedKeys().size() == 1
              && resource.data.get('noms', {}).size() == 0
              && request.resource.data.get('picks', {})
                   .diff(resource.data.get('picks', {})).addedKeys().size() == 0
              && inWindow(0, 7) )
            ||
            ( // yeni maç oyu: o maça İLK kez, doğru pencerede
              request.resource.data.get('picks', {})
                .diff(resource.data.get('picks', {})).addedKeys().size() == 1
              && request.resource.data.get('noms', {})
                   .diff(resource.data.get('noms', {})).addedKeys().size() == 0
              && request.resource.data.lastKey is string
              && request.resource.data.get('picks', {})
                   .diff(resource.data.get('picks', {})).addedKeys()
                   .hasOnly([request.resource.data.lastKey])
              && pickValueOk(request.resource.data.lastKey)
              && pickWindowOk(request.resource.data.lastKey) )
          );
      }

      // Topluluk havuzu (tournaments/{periodId}/pool/{tmdbId}) — ay başı TMDB
      // anlık görüntüsü yalnız o türün EN POPÜLER 64 yapımıdır; kullanıcı seçim
      // fazında arayıp havuzda olmayan bir yapımı ekleyebilir.
      //
      // SPAM FRENİ: ekleme, kullanıcının TEK hype'ına bağlıdır — noms'unda
      // YALNIZ bu id olmalı. noms bir kez yazılıp bir daha değişemediğinden
      // (yukarıdaki votes kuralları) bu, kişi başına ömür boyu EN FAZLA BİR
      // öneri demektir. İstemci önce hype'ı yazar, sonra havuz kaydını.
      //
      // Doküman id'si TMDB id'sidir (aynı yapım iki kez eklenemez) ve kayıt
      // DEĞİŞMEZDİR: bracket her istemcide bu listeden türetilir.
      match /pool/{itemId} {
        // Ekleme hakkı = kullanıcının TEK hype'ı ve o hype bu yapıma verilmiş
        // olmalı. size() == 1 şart: hasOnly() BOŞ map'te de true döner, yani
        // tek başına hiç hype vermemiş kullanıcıya sınırsız ekleme açardı.
        function myNoms() {
          return get(/databases/$(database)/documents/tournaments/$(periodId)/votes/$(request.auth.uid))
                 .data.get('noms', {});
        }
        function hypedThis() {
          return exists(/databases/$(database)/documents/tournaments/$(periodId)/votes/$(request.auth.uid))
              && myNoms().size() == 1
              && myNoms().get(itemId, false) == true;
        }
        function shapeOk() {
          return request.resource.data.keys().hasOnly(
                   ['title','posterPath','mediaType','popularity','voteAverage','year','addedBy','addedAt'])
              && request.resource.data.addedBy == request.auth.uid
              && request.resource.data.addedAt == request.time
              && request.resource.data.title is string
              && request.resource.data.title.size() > 0
              && request.resource.data.title.size() <= 120
              && request.resource.data.posterPath is string
              && request.resource.data.posterPath.size() <= 120
              && request.resource.data.popularity is number
              && request.resource.data.voteAverage is number
              && request.resource.data.mediaType
                 == get(/databases/$(database)/documents/tournaments/$(periodId)).data.mediaType;
        }

        allow read: if isSignedIn();
        allow update, delete: if false;   // havuz anlık görüntüsü dondurulur
        allow create: if isSignedIn()
          && inWindow(0, 7)               // yalnız seçim fazı
          && itemId.matches('[0-9]+')     // doküman id'si = TMDB id'si
          && shapeOk()
          && hypedThis();
      }

      // Agregat sayaçlar (tournaments/{periodId}/agg/tallies) — Cloud Function
      // yazar (onTournamentVoteWritten). İstemci yalnız okur: N oy dokümanı
      // yerine TEK doküman dinlenir → çok kullanıcıda okuma maliyeti sabitlenir.
      match /agg/{docId} {
        allow read: if isSignedIn();
        allow write: if false;
      }
    }
  }
}
