# DİKKAT: Bu dosya varken EAS `.gitignore`'u YOK SAYAR — yükleme kapsamını
# yalnız buradaki liste belirler.
#
# APK / iOS derlemesi yapılırken buluta gereksiz hiçbir dosya (testler, web sitesi,
# dokümanlar, cloud functions, scriptler, loglar) yüklenmez.

# Dependencies (installed on EAS server)
node_modules/

# Native directories (regenerated by prebuild on EAS)
/android/
/ios/

# Expo & Web builds
.expo/
.expo-check-export/
dist/
web-build/

# Web sitesi ve Backend (APK içinde kullanılmaz)
website/
functions/
database.rules.json
firestore.rules
firestore.indexes.json
firebase.json
.firebaserc

# Dokümantasyon & Proje Notları
docs/
README.md

# Testler ve Mock'lar
__tests__/
__mocks__/
*.test.js
*.spec.js
jest.config.js
jest.rules.config.js

# Yerel Yardımcı Scriptler (Migration, fix vb.)
scripts/

# AI Agent & IDE Araçları
.claude/
.agent/
.agents/
.codex/
.vscode/
.idea/

# Firebase & Deploy önbellekleri
.firebase/

# Build & Debug Logları
*.log
firestore-debug.log
firebase-debug.log
database-debug.log
ui-debug.log
npm-debug.*
yarn-debug.*
yarn-error.*
crash.txt
nul

# OS & Sistem Dosyaları
.DS_Store
*.tsbuildinfo

# Git
.git/

# Environment files
.env
.env*.local

# İmzalama anahtarları ve servis hesapları
*.jks
*.p8
*.p12
*.key
*.pem
*.mobileprovision
*-firebase-adminsdk-*.json

# Rebrand öncesi ölü ikon yedekleri ve kullanılmayan Lottie animasyonları
assets/oldicon/
assets/oldicon1/
assets/unused-lottie/
