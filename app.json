{
  "expo": {
    "name": "Watchify",
    "slug": "WatchFlix",
    "version": "1.4.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/android-icon-foreground.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E1E1E"
    },
    "scheme": "watchify",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#00000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "splash": {
        "image": "./assets/android-icon-foreground.png",
        "resizeMode": "contain",
        "backgroundColor": "#1E1E1E"
      },
      "package": "com.smlztrk.Watchify",
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        //"projectId": "b0ff17ab-04b9-4e70-8e3d-588770bfdc5c"
           "projectId": "3bbd3b81-8382-4788-bfc9-dbde13043eaf"
      }
    },
    "plugins": [
      "@react-native-google-signin/google-signin",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#1E1E1E",
          "defaultChannel": "default"
        }
      ],
      "expo-web-browser",
      [
        "expo-media-library",
        {
          "photosPermission": "Uygulamanın oluşturduğun story görselini galerine kaydetmesine izin ver.",
          "savePhotosPermission": "Uygulamanın oluşturduğun story görselini galerine kaydetmesine izin ver.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "owner": "smlztrk"
  }
}
