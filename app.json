{
  "expo": {
    "name": "Seelogd",
    "slug": "seelogd",
    "version": "1.4.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "seelogd",
    "ios": {
      "bundleIdentifier": "com.smlztrk.seelogd",
      "supportsTablet": true,
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.smlztrk.seelogd"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#00000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.smlztrk.seelogd",
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ],
      "blockedPermissions": [
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/android-icon-foreground.png",
          "resizeMode": "contain",
          "backgroundColor": "#1E1E1E"
        }
      ],
      "@bacons/apple-targets",
      "@react-native-google-signin/google-signin",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1E1E1E",
          "defaultChannel": "default"
        }
      ],
      "expo-web-browser",
      [
        "expo-media-library",
        {
          "photosPermission": "Uygulamanın oluşturduğun story görselini galerine kaydetmesine izin ver.",
          "savePhotosPermission": "Uygulamanın oluşturduğun story görselini galerine kaydetmesine izin ver.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/analytics",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://de.sentry.io/",
          "project": "react-native",
          "organization": "seelogd"
        }
      ],
      "./plugins/withAndroidWidgets.js",
      "expo-secure-store"
    ],
    "owner": "smlztrk",
    "updates": {
      "url": "https://u.expo.dev/9c17fe1c-ca63-4de3-af7a-76d131e3db7a"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.smlztrk.seelogd.widget",
                  "targetName": "ReminderWidget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.smlztrk.seelogd"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "9c17fe1c-ca63-4de3-af7a-76d131e3db7a"
      }
    }
  }
}
