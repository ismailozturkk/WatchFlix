# npm sürümleri arasında deterministik ağaç üretimi için.
#
# Sorun: npm 10 ile npm 11 opsiyonel peer bağımlılıklarını (peerDependenciesMeta
# .optional = true) FARKLI ele alıyor. npm 11 onları kurmuyor ve lock'tan siliyor,
# npm 10 kurmaya çalışıyor. Yerelde npm 11, EAS Build imajında npm 10 var; bu fark
# iki yönlü de hata üretti:
#
#   1. npm 11 ile üretilen lock -> EAS'te "npm ci" EUSAGE ile patlıyor
#      ("Missing: @react-native-async-storage/async-storage@1.24.0 from lock file",
#       firebase ve @firebase/auth-compat altındaki iç içe kayıtlar siliniyordu).
#   2. npm 10 ile kurulum -> ERESOLVE, çünkü @react-native-community/datetimepicker
#      opsiyonel peer olarak react-native-windows istiyor ve RNW'nin RN 0.86'yı
#      destekleyen sürümü yok.
#
# legacy-peer-deps her iki npm sürümünde de peer bağımlılıklarını ağaç kurulumunun
# dışında bırakır, yani lock her yerde aynı çıkar. Bu projede gerçek peer'lerin
# tamamı (react, react-native, expo, react-native-worklets, datetimepicker,
# masked-view) zaten doğrudan bağımlılık olarak beyan edildiği için kayıp peer riski
# yok. eas.json'da npm sürümü pinlenemediği için (build profili yalnız node/yarn/
# pnpm/bun kabul ediyor) çözüm bu dosyada.
legacy-peer-deps=true
