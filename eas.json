{
  "cli": {
    "version": ">= 13.1.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      }
    },
    "appetize": {
      "extends": "preview",
      "env": {
        "FIREBASE_SDK_VERSION": "12.14.0"
      },
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "environment": "production",
      "env": {
        "FIREBASE_SDK_VERSION": "12.14.0"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6801549169"
      }
    }
  }
}
